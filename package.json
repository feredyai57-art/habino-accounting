{
  "name": "habino-accounting",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --packages=external --define:import.meta.env=undefined",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --packages=external --define:import.meta.env=undefined",
    "start": "node dist/server.cjs",
    "test": "tsx scripts/run-accounting-tests.ts",
    "test:accounting": "tsx scripts/run-accounting-tests.ts",
    "test:core-accounting": "tsx scripts/test-core-accounting-regressions.ts",
    "test:equity-capital": "tsx scripts/test-equity-capital-engine.ts",
    "test:formulas": "tsx scripts/test-accounting-formulas-exhaustive.ts",
    "test:license-entitlements": "tsx scripts/test-license-entitlements.ts",
    "test:omniroute": "tsx scripts/test-omniroute-config.ts",
    "test:security": "tsx scripts/run-security-and-rls-tests.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@google/genai": "^0.2.0",
    "@supabase/supabase-js": "^2.117.3",
    "@types/leaflet": "^1.9.22",
    "@vis.gl/react-google-maps": "^1.10.2",
    "@zxing/library": "^0.23.0",
    "express": "^4.21.2",
    "html2canvas-pro": "^2.5.2",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "openai": "^7.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "deepmerge": "^4.3.1",
    "glob": "^11.0.1",
    "minimatch": "^10.1.1"
  }
}
